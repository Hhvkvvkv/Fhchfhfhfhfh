  --data-urlencode "message=اكتب لي مقال عن القهوة" \
  -H "X-API-Key: $KEY"

curl -G "$URL/correct" \
  --data-urlencode "text=انا بستخدم برنامج فوتوشوب وVs code في الشغل" \
  -H "X-API-Key: $KEY"
